# Copy to .env.local. Restart next dev after changing these values.
# demo uses local sample data; supabase never falls back to sample data on errors.
NEXT_PUBLIC_DATA_MODE=demo

# Supabase Dashboard > Project Settings / API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative (anon only, NEVER service_role):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: pin the organization after running the SQL bootstrap.
# Blank selects an active workspace membership for the signed-in user.
NEXT_PUBLIC_SUPABASE_ORGANIZATION_ID=

# No service-role key or database password is needed by the web application.
# Install migrations and provision Auth users/memberships before using connected mode.
